# IMPORTANT: copy these into Netlify Environment Variables (scope: Functions).
# NEVER commit real secrets in the project or under public/.
ADMIN_USERNAME=admin
# easiest setup: use ADMIN_PASSWORD as a Netlify secret env variable (14+ chars)
ADMIN_PASSWORD=choose-very-long-unique-password
# optional hardened alternative (takes precedence):
# ADMIN_PASSWORD_HASH=scrypt$<salthex>$<hashhex>
SESSION_SECRET=use-a-fresh-random-secret-at-least-32-characters
SMTP_USER=office@example.com
SMTP_PASS=your-google-app-password-not-your-google-account-password
NOTIFICATION_EMAIL=office@example.com
# Optional spam controls (the default is 5 submissions per hour per IP)
